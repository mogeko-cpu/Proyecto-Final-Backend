/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Exige JWT y valida @Roles; errores {statusCode, message, path, timestamp}&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="250" height="170" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Casos de uso&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[Clases TypeScript sin framework]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;auth: RegisterUser, Login, RefreshSession, Authenticate, Logout, DeleteAccount · inventory: CreateDeposit, CreateRecord, UpdateRecord, ArchiveRecord · monitoring: RegisterInspection, IngestReading, EvaluateOverdue · interventions: AssignTask, UpdateTask · dashboard: GetDashboard&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="220" width="250" height="330" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Servicios comunes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[application/common.ts]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;ListItems, Health, openAlert / resolveAlerts (no duplica alertas)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;arcSize=8;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="610" width="250" height="170" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Entidades&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;[model.ts · TypeScript puro]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;User, Session, Deposit, RecordFile, Inspection, Reading, Alert, Task y BusinessError&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;arc